FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app FLATFORGE_HOST=0.0.0.0 FLATFORGE_PORT=8765
WORKDIR /app
COPY flatforge_proto ./flatforge_proto
COPY flatforge_worker ./flatforge_worker
RUN useradd --system --uid 10001 --no-create-home flatforge
USER 10001:10001
EXPOSE 8765
CMD ["python", "-m", "flatforge_worker.server"]
